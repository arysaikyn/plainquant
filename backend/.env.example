# Backend proxy (safe defaults for local development)
VIBE_API_URL=http://127.0.0.1:8899
# Must match API_AUTH_KEY on the Vibe-Trading process.
VIBE_API_KEY=change-me
APP_PORT=8000
VIBE_REQUEST_TIMEOUT=120

# The ask path (docs/architecture.md, "The ask path"). Without a key it answers 503.
# ANTHROPIC_API_KEY=
# ENGINE_MODEL=claude-haiku-5-5
# SNAPSHOT_DIR=../data/raw/csi300
