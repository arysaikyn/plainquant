{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arysaikyn/plainquant/model/signals.schema.json",
  "title": "Signals file",
  "description": "The single data contract between model/ and web/. Generated per run and not committed. Decimals are fractions: 0.12 means 12%. Dates use ISO 8601. max_drawdown is zero or negative. 1.2 embeds the spec the run executed and drops the fields it repeated (market, rules, backtest start/end/rebalance): a fact has one owner. 1.2 also makes the audit and the receipt mandatory, so a result cannot be emitted without its grid check. No earlier version is accepted; no consumer read 1.0 or 1.1.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "as_of",
    "query",
    "spec",
    "receipt",
    "rows",
    "audit"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "$ref": "spec.schema.json"
    },
    "receipt": {
      "type": "object",
      "description": "What makes the run reproducible: the same spec on the same data with the same engine gives the same result.",
      "required": [
        "spec_hash",
        "data_version",
        "engine_version"
      ],
      "additionalProperties": false,
      "properties": {
        "spec_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the spec in canonical JSON (RFC 8785)."
        },
        "data_version": {
          "type": "string",
          "minLength": 1,
          "description": "The point-in-time data snapshot the engine read."
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "rank",
          "score",
          "factors"
        ],
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number"
          },
          "factors": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "sector": {
            "type": "string"
          },
          "sharia": {
            "enum": [
              "compliant",
              "non_compliant",
              "unknown"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "backtest": {
      "type": "object",
      "description": "Present when the spec was run over its period. Dates and rebalance frequency are in the spec.",
      "required": [
        "metrics"
      ],
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "object",
          "required": [
            "annual_return",
            "max_drawdown",
            "sharpe"
          ],
          "additionalProperties": {
            "type": "number"
          },
          "properties": {
            "annual_return": {
              "type": "number"
            },
            "max_drawdown": {
              "type": "number",
              "maximum": 0
            },
            "sharpe": {
              "type": "number"
            }
          }
        },
        "equity_curve": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "description": "Checks that do not depend on the ranking. A strategy whose return loads on the size of a move instead of its direction is running a grid, whatever the rules say. Required: the engine cannot hand the web a result without it.",
      "required": [
        "grid"
      ],
      "additionalProperties": false,
      "properties": {
        "grid": {
          "type": "object",
          "required": [
            "score",
            "verdict",
            "families",
            "findings"
          ],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Grid likeness. 0 is a cross-sectional rule set; 100 is an order sheet a grid bot would write."
            },
            "verdict": {
              "enum": [
                "crossSection",
                "thin",
                "gridlike"
              ]
            },
            "families": {
              "type": "array",
              "items": {
                "enum": [
                  "price",
                  "volume",
                  "momentum",
                  "reversal",
                  "volatility",
                  "fundamental",
                  "sharia",
                  "event"
                ]
              },
              "description": "Factor families the rules read. A set, so order is not meaningful."
            },
            "path_exposure": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1,
              "description": "Share of the run's return that needs |market move| rather than the signed move. Null when there is no equity curve."
            },
            "persistence": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "gamma1",
                    "sr",
                    "stop"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "gamma1": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1,
                      "description": "Lag-one autocorrelation of the run's returns at the backtest frequency. Negative means mean reversion."
                    },
                    "sr": {
                      "type": "number",
                      "description": "Mean over standard deviation of the same returns, per observation."
                    },
                    "stop": {
                      "enum": [
                        "adds",
                        "insurance",
                        "hurts"
                      ],
                      "description": "Kaminski and Lo: whether a stop would add return at this horizon. Describes the data; the product has no stop."
                    }
                  }
                }
              ],
              "description": "Null when there is no equity curve."
            },
            "findings": {
              "type": "array",
              "description": "Every finding the score was charged for, with its points.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "points"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "enum": [
                      "noExitPolicy",
                      "priceOnly",
                      "shortDecay",
                      "volHarvest",
                      "stopHurts",
                      "highTurnover",
                      "concentrated"
                    ]
                  },
                  "points": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "description": "The Sharia screen runs before ranking, so under compliant_only a ranked row is compliant. unknown is not compliant.",
      "if": {
        "properties": {
          "spec": {
            "properties": {
              "sharia": {
                "const": "compliant_only"
              }
            },
            "required": [
              "sharia"
            ]
          }
        },
        "required": [
          "spec"
        ]
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "required": [
                "sharia"
              ],
              "properties": {
                "sharia": {
                  "const": "compliant"
                }
              }
            }
          }
        }
      }
    }
  ]
}
